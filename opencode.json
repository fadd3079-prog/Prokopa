{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@vheins/opencode-9router@latest"
  ],

  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:20128",
        "apiKey": "{env:OPENCODE_9ROUTER_API_KEY}",
        "cache": true,
        "discoveryTimeout": 60000
      }
    }
  },

  "mcp": {
    "graphify": {
      "type": "remote",
      "url": "https://api.graphify.com/mcp",
      "enabled": true
    }
  }
}